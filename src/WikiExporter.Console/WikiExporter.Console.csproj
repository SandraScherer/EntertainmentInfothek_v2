<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WikiExporter.Application\WikiExporter.Application.csproj" />
    <ProjectReference Include="..\WikiExporter.Infrastructure\WikiExporter.Infrastructure.csproj" />
    <ProjectReference Include="..\WikiExporter.Markdown\WikiExporter.Markdown.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0-preview.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
